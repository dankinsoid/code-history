{
  "name": "codehistory",
  "displayName": "CodeHistory",
  "description": "Check any line history",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codehistory.showLineHistory",
        "title": "Show Line History"
      },
      {
        "command": "codehistory.showHistoryAsCompletions",
        "title": "Show Line History as Completions"
      },
      {
        "command": "codehistory.showHistoryAsInlineCompletions",
        "title": "Show Line History as Inline Completions"
      },
      {
        "command": "codehistory.nextCommit",
        "title": "Next Commit"
      },
      {
        "command": "codehistory.prevCommit",
        "title": "Previous Commit"
      },
      {
        "command": "codehistory.toggleViewMode",
        "title": "Toggle History View Mode"
      },
      {
        "command": "codehistory.showCommitDetails",
        "title": "Show Commit Details"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codehistory.showLineHistory",
          "when": "editorTextFocus && !editorReadonly",
          "group": "navigation"
        },
        {
          "command": "codehistory.showHistoryAsCompletions",
          "when": "editorTextFocus && !editorReadonly",
          "group": "navigation"
        },
        {
          "command": "codehistory.showHistoryAsInlineCompletions",
          "when": "editorTextFocus && !editorReadonly",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Code History",
      "properties": {
        "codehistory.showDiff": {
          "type": "boolean",
          "default": false,
          "description": "Show diff for each commit instead of the state of lines"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "ts-loader": "^9.5.2",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
